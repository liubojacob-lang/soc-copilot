###############################################################################
# SOC Copilot - 通知渠道配置示例
# 复制此文件到 .env 并填入实际值
###############################################################################

# ============================================
# Redis 配置
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# 飞书 (Feishu/Lark) 通知配置
# ============================================
# 获取方式:
# 1. 创建飞书群聊
# 2. 添加"自定义机器人"
# 3. 获取 Webhook URL
#FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ============================================
# Slack 通知配置
# ============================================
# 获取方式:
# 1. 创建 Slack App
# 2. 启用 Incoming Webhooks
# 3. 获取 Webhook URL
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# ============================================
# 邮件通知配置
# ============================================
# 收件人邮箱 (可以配置多个，用逗号分隔)
#ALERT_EMAIL_TO=security-team@company.com,admin@company.com

# SMTP 服务器配置
#SMTP_SERVER=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USERNAME=your-email@gmail.com
#SMTP_PASSWORD=your-app-password

# 其他 SMTP 服务器示例:
# Office 365:
#   SMTP_SERVER=smtp.office365.com
#   SMTP_PORT=587
#
# SendGrid:
#   SMTP_SERVER=smtp.sendgrid.net
#   SMTP_PORT=587
#
# AWS SES:
#   SMTP_SERVER=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587

# ============================================
# SOC Copilot 基础配置
# ============================================
# 基础 URL (用于生成告警详情链接)
#SOC_BASE_URL=https://soc.yourcompany.com

# ============================================
# Worker 配置
# ============================================
# Worker 标识 (可选，默认使用容器主机名)
#WORKER_ID=worker-1

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
#LOG_LEVEL=INFO

# ============================================
# 备份配置
# ============================================
# 备份目录
#BACKUP_DIR=./backups

# 备份保留天数
#BACKUP_RETENTION_DAYS=30

# ============================================
# 快速开始
# ============================================
# 1. 复制此文件:
#    cp .env.notifications.example .env
#
# 2. 取消并配置至少一个通知渠道 (飞书/Slack/Email)
#
# 3. 重启服务:
#    docker-compose -f docker-compose.prod.yml up -d
#
# 4. 测试通知 (可选):
#    curl -X POST http://localhost:8000/api/v1/notifications/test
#
# ============================================
