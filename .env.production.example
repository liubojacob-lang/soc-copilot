# SOC Copilot 生产环境变量模板
# 用法：
#   1. 复制为 .env.production 并填写所有必填值
#   2. 验证：docker compose --env-file .env.production -f docker-compose.prod.yml config -q
#   3. 启动：docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# 生成强密钥：
#   JWT_SECRET           -> python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   SECRET_ENCRYPTION_KEY-> python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   DB_PASSWORD / REDIS_PASSWORD -> openssl rand -base64 24

# ── 必填（compose :? 守卫强制）────────────────────────────────
DB_USER=soc_copilot
DB_PASSWORD=CHANGE_ME_openssl_rand_base64_24
DB_NAME=soc_copilot
REDIS_PASSWORD=CHANGE_ME_openssl_rand_base64_24
JWT_SECRET=CHANGE_ME_secrets_token_urlsafe_48_min_32_chars
SECRET_ENCRYPTION_KEY=CHANGE_ME_fernet_key
HTTP_ALLOWED_HOSTS=otx.alienvault.com,hooks.slack.com,api.nvidia.com
CORS_ORIGINS=https://soc.example.com
DOCKERHUB_USERNAME=CHANGE_ME_registry_namespace
API_URL=https://soc.example.com

# ── 强烈建议修改 ─────────────────────────────────────────────
BOOTSTRAP_ADMIN_USERNAME=admin
# ≥12 字符；首登会被强制改密（must_change_password）
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_min_12_chars
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
WORKER_ID=1
ENVIRONMENT=production
STRICT_PRODUCTION_CHECKS=true

# ── 通知渠道（可选，不填则禁用）──────────────────────────────
FEISHU_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_USERNAME=
SMTP_PASSWORD=
SOC_BASE_URL=https://soc.example.com

# ── AI Provider（可选，chat 降级为规则引擎）──────────────────
AI_PROVIDER=nvidia
NVIDIA_API_KEY=

# ── 镜像版本 ─────────────────────────────────────────────────
IMAGE_TAG=0.9.0
