# SOC Copilot Environment Configuration
# Copy this file to .env and update with your values

# ========================================
# Database Configuration
# ========================================
# Generate secure passwords: openssl rand -base64 32
DB_USER=soc_copilot
DB_PASSWORD=
DB_NAME=soc_copilot

# ========================================
# Redis Configuration
# ========================================
REDIS_PASSWORD=

# ========================================
# Backend Security
# ========================================
# Generate secret key: openssl rand -base64 64
SECRET_KEY=
ENVIRONMENT=development

# ========================================
# CORS Configuration
# ========================================
# Comma-separated list of allowed origins
# Example: http://localhost:3000,https://your-domain.com
CORS_ORIGINS=http://localhost:3003

# ========================================
# AI Provider Configuration
# ========================================
# Options: anthropic, zhipu
AI_PROVIDER=zhipu

# Zhipu AI
ZHIPU_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# ========================================
# Threat Intelligence (OTX)
# ========================================
OTX_API_KEY=
ALLOW_EXTERNAL_TI=false
TI_CACHE_TTL_HOURS=168

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO

# ========================================
# Optional: Dify AI Integration
# ========================================
DIFY_API_URL=
DIFY_API_KEY=
