# Wazuh Environment Configuration
# Copy this file to .env.wazuh and update with your values

# ========================================
# Wazuh Indexer (OpenSearch) Credentials
# ========================================
# Generate secure password: openssl rand -base64 32
WAZUH_INDEXER_PASSWORD=<CHANGE_ME_USE_OPENSSL_RAND_BASE64_32>

# ========================================
# Filebeat Credentials
# ========================================
# Generate secure password: openssl rand -base64 32
FILEBEAT_PASSWORD=<CHANGE_ME_USE_OPENSSL_RAND_BASE64_32>

# ========================================
# Wazuh API Credentials
# ========================================
WAZUH_API_USERNAME=wazuh-wui
# Generate secure password: openssl rand -base64 32
WAZUH_API_PASSWORD=<CHANGE_ME_USE_OPENSSL_RAND_BASE64_32>

# ========================================
# Wazuh Email Configuration
# ========================================
WAZUH_EMAIL=wazuh@example.com

# ========================================
# Wazuh Database Credentials
# ========================================
WAZUH_DB_USER=wazuh
# Generate secure password: openssl rand -base64 32
WAZUH_DB_PASSWORD=<CHANGE_ME_USE_OPENSSL_RAND_BASE64_32>
WAZUH_DB_NAME=wazuh

# ========================================
# SOC Copilot Integration Settings
# ========================================
WAZUH_ENABLED=true
WAZUH_REQUIRED=false
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USERNAME=wazuh-wui
# Generate secure password: openssl rand -base64 32
WAZUH_API_PASSWORD=<CHANGE_ME_USE_OPENSSL_RAND_BASE64_32>

# SECURITY: SSL verification — production MUST be true.
# Set to false ONLY for local dev with self-signed certs.
# P0-6: default changed to true (secure-by-default).
WAZUH_VERIFY_SSL=true

# ========================================
# Wazuh Receiver Settings
# ========================================
WAZUH_RECEIVER_ENABLED=true
WAZUH_RECEIVER_AUTO_START=true

# ========================================
# Wazuh Stream Configuration
# ========================================
WAZUH_STREAM_ENABLED=true
WAZUH_STREAM_AGGREGATION_WINDOW_SECONDS=60
WAZUH_STREAM_MAX_BUFFER_SIZE=10000
WAZUH_STREAM_MAX_HISTORY_SIZE=1000
