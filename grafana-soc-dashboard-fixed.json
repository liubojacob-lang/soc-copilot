{
  "dashboard": {
    "title": "SOC Copilot 安全告警中心",
    "uid": "soc-copilot-security-dashboard",
    "schemaVersion": 39,
    "version": 1,
    "description": "SOC Copilot 实时安全告警监控仪表板",
    "tags": ["security", "soc", "alerts"],
    "timezone": "browser",
    "refresh": "10s",
    "time": {
      "from": "now-5m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "告警总数 (实时)",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "bfedbqw7nppfkd"
            },
            "expr": "count_over_time({job=\"soc-copilot\"}[1h])",
            "refId": "A",
            "legendFormat": "总数"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 10,
                  "color": "yellow"
                },
                {
                  "value": 50,
                  "color": "red"
                }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "高危告警趋势",
        "type": "timeseries",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 18,
          "h": 4
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "bfedbqw7nppfkd"
            },
            "expr": "count_over_time({job=\"soc-copilot\", level=\"critical\"}[5m])",
            "refId": "A",
            "legendFormat": "Critical"
          },
          {
            "datasource": {
              "type": "loki",
              "uid": "bfedbqw7nppfkd"
            },
            "expr": "count_over_time({job=\"soc-copilot\", level=\"high\"}[5m])",
            "refId": "B",
            "legendFormat": "High"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        }
      },
      {
        "id": 3,
        "title": "告警类型分布",
        "type": "piechart",
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "bfedbqw7nppfkd"
            },
            "expr": "count by (event_type) ({job=\"soc-copilot\"})",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right"
          }
        }
      },
      {
        "id": 4,
        "title": "最新告警列表",
        "type": "logs",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "bfedbqw7nppfkd"
            },
            "expr": "{job=\"soc-copilot\"}",
            "refId": "A"
          }
        ],
        "options": {
          "showLabels": true,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        }
      },
      {
        "id": 5,
        "title": "Top 源 IP",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 12,
          "h": 6
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "bfedbqw7nppfkd"
            },
            "expr": "topk(10, sum by (source_ip) ({job=\"soc-copilot\"}))",
            "refId": "A"
          }
        ],
        "options": {
          "showHeader": true
        }
      },
      {
        "id": 6,
        "title": "Top 攻击类型",
        "type": "bargauge",
        "gridPos": {
          "x": 12,
          "y": 20,
          "w": 12,
          "h": 6
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "bfedbqw7nppfkd"
            },
            "expr": "topk(5, count by (event_type) ({job=\"soc-copilot\"}))",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      }
    ]
  },
  "overwrite": false
}
