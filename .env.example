# Backend
backend/.env - Configure ANTHROPIC_API_KEY

# Frontend (optional)
NEXT_PUBLIC_API_URL=http://localhost:8000

# v0.9.0: Notification Channels
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_WEBHOOK_URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=security-team@yourcompany.com

# v1.0.0: Wazuh SIEM Integration
WAZUH_ENABLED=true
WAZUH_API_URL=https://wazuh.example.com:55000
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=your-wazuh-password
WAZUH_API_CERT_PATH=/path/to/wazuh-cert.pem
WAZUH_VERIFY_SSL=true
WAZUH_RECEIVER_ENABLED=true
WAZUH_RECEIVER_AUTO_START=true
WAZUH_POLL_INTERVAL=30
WAZUH_BATCH_SIZE=100
WAZUH_LOOKBACK_MINUTES=5
