{
  "id": "sigma-linux-001",
  "title": "Reverse Shell Detection via Bash",
  "description": "Detects common bash reverse shell one-liners using /dev/tcp/, nc -e, python socket, or perl Socket patterns.",
  "status": "stable",
  "level": "critical",
  "author": "SOC Copilot",
  "category": "linux",
  "tags": [
    "attack.execution",
    "attack.t1059.004"
  ],
  "mitre_techniques": [
    "T1059.004"
  ],
  "logsource": {
    "product": "linux",
    "service": "audit"
  },
  "detection": {
    "selection": {
      "syscall": 59,
      "comm": "bash",
      "cmdline|contains": [
        "/dev/tcp/",
        "bash -i >&",
        "0>&1",
        "nc -e /bin/bash",
        "python -c 'import socket",
        "perl -e 'use Socket"
      ]
    },
    "condition": "selection"
  },
  "false_positives": [
    "Developer testing (verify context)"
  ],
  "references": [
    "https://attack.mitre.org/techniques/T1059/004/"
  ]
}