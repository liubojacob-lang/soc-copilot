# ============================================================================
# SOC Copilot 开发环境配置模板
# ============================================================================
# 使用方法:
#   1. 复制此文件: cp .env.example .env
#   2. 或使用自动化脚本: make setup-env
#   3. 更新标记为 [必填] 的配置项
#
# 安全说明:
#   - 本文件可提交到版本控制（不含真实密钥）
#   - .env 文件已加入 .gitignore，不会被提交
#   - 密钥生成命令: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================================

# ========================================
# 运行环境 [必填]
# ========================================
# development | production
# production 时将校验敏感默认值，缺失关键配置将拒绝启动
ENVIRONMENT=development

# ========================================
# 数据库配置 [必填]
# ========================================
# PostgreSQL 连接配置
# 开发环境默认值适配 docker-compose.dev.yml
# 生成安全密码: openssl rand -base64 32
DB_USER=soc_copilot
DB_PASSWORD=                          # [必填] 生产环境必须设置
DB_NAME=soc_copilot
DB_HOST=localhost                     # Docker: postgres, 本地: localhost
DB_PORT=5432                          # 默认: 5432

# SQLAlchemy 数据库 URL（自动组装，通常无需手动设置）
# DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# SQLite 本地开发（不使用 Docker 时）
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ========================================
# Redis 配置 [必填]
# ========================================
# 开发环境默认值适配 docker-compose.dev.yml
REDIS_ENABLED=false                   # [选填] 启用 Redis（token 黑名单、限流等）
REDIS_URL=redis://localhost:6379/0    # Docker: redis://redis:6379/0
REDIS_PASSWORD=                       # [选填] 开发环境可留空

# ========================================
# 应用安全配置 [必填]
# ========================================
# 应用密钥 - 用于会话加密等
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=                           # [必填] 生产环境必须设置，至少32字符

# JWT 配置
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=                           # [必填] 生产环境必须设置，至少32字符
JWT_SECRET_PREVIOUS=                  # [选填] JWT 轮换过渡期旧密钥
JWT_EXPIRE_MINUTES=720                # [选填] JWT 过期时间（分钟），默认 720 (12h)
JWT_REFRESH_EXPIRE_MINUTES=10080      # [选填] Refresh Token 过期时间，默认 10080 (7d)

# 初始管理员账户
# ⚠️ 首次登录后必须立即修改密码！
BOOTSTRAP_ADMIN_USERNAME=admin        # [选填] 默认: admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com  # [选填] 默认: admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=             # [必填] 生产环境必须设置，至少12字符

# 生产环境严格检查
STRICT_PRODUCTION_CHECKS=false        # [选填] 生产环境建议设为 true

# Fernet 对称加密密钥（用于 Secrets 管理等）
# 生成方法: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=                # [选填] Playbook Secrets 功能需要

# ========================================
# CORS 配置
# ========================================
# 逗号分隔的允许来源列表
# 开发环境默认: http://localhost:3003
# 生产环境示例: https://soc.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3003

# ========================================
# 日志配置
# ========================================
# DEBUG | INFO | WARNING | ERROR
# 开发环境建议: INFO 或 DEBUG
# 生产环境建议: WARNING
LOG_LEVEL=INFO

# ========================================
# AI Provider 配置 [必填-至少一个]
# ========================================
# 选择 AI 提供商: zhipu | openrouter | anthropic | nvidia | moonshot
AI_PROVIDER=openrouter

# --- OpenRouter (推荐) ---
# 获取 API Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=                   # [选填] OpenRouter API Key
OPENROUTER_MODEL=moonshotai/kimi-k2.5 # [选填] 默认模型

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=                    # [选填]

# --- Zhipu AI (智谱) ---
ZHIPU_API_KEY=                        # [选填]

# --- Moonshot AI (Kimi) ---
MOONSHOT_API_KEY=                     # [选填]
MOONSHOT_MODEL=moonshot-v1-8k         # [选填]

# --- NVIDIA AI ---
NVIDIA_API_KEY=                       # [选填]
NVIDIA_MODEL=meta/llama-3.1-405b-instruct  # [选填]

# --- Dify AI (可选集成) ---
DIFY_API_URL=                         # [选填]
DIFY_API_KEY=                         # [选填]

# AI 重试配置
MAX_RETRIES=2                         # [选填] 默认: 2

# ========================================
# Playbook 引擎配置
# ========================================
# 最大并发 Playbook 执行数
RUN_QUEUE_MAX=3                       # [选填] 默认: 3
# 队列策略: fifo | priority
RUN_QUEUE_POLICY=fifo                 # [选填] 默认: fifo

# HTTP 沙箱: 逗号分隔的允许主机名
# 生产环境必须设置，开发环境可留空允许所有
HTTP_ALLOWED_HOSTS=                   # [选填] 开发环境留空

# ========================================
# 通知配置 [选填]
# ========================================
# 飞书 Webhook
#FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# Slack Webhook
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# 邮件告警
#ALERT_EMAIL_TO=security-team@company.com
#SMTP_SERVER=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USERNAME=your-email@gmail.com
#SMTP_PASSWORD=your-app-password

# 告警详情链接基础 URL
#SOC_BASE_URL=https://soc.yourcompany.com

# ========================================
# 威胁情报配置
# ========================================
OTX_API_KEY=                          # [选填] AlienVault OTX API Key
ALLOW_EXTERNAL_TI=false               # [选填] 是否允许外部 TI 查询，默认: false
TI_CACHE_TTL_HOURS=168               # [选填] 缓存 TTL（小时），默认: 168 (7天)
TI_MAX_IOCS_PER_REQUEST=20           # [选填] 每次请求最大 IOC 数，默认: 20

# IOC 合规过滤
TI_ALLOW_PRIVATE_IP=false            # [选填] 允许发送私有 IP，默认: false
TI_INTERNAL_DOMAIN_SUFFIXES=         # [选填] 内部域名后缀（逗号分隔）
TI_BLOCKED_TLDS=                     # [选填] 阻止的 TLD（逗号分隔）
TI_ALLOW_URL_WITH_PRIVATE_HOST=false # [选填] 允许私有 IP 主机的 URL，默认: false

# ========================================
# Wazuh 集成 [选填]
# ========================================
WAZUH_ENABLED=true                    # [选填] 是否启用 Wazuh 集成
WAZUH_REQUIRED=false                  # [选填] Wazuh 是否必须可用
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=                   # [选填]
WAZUH_VERIFY_SSL=true

WAZUH_INDEXER_PASSWORD=              # [选填]
FILEBEAT_PASSWORD=                    # [选填]
WAZUH_EMAIL=wazuh@example.com

WAZUH_DB_USER=wazuh
WAZUH_DB_PASSWORD=                    # [选填]
WAZUH_DB_NAME=wazuh

WAZUH_RECEIVER_ENABLED=true
WAZUH_RECEIVER_AUTO_START=true

WAZUH_STREAM_ENABLED=true
WAZUH_STREAM_AGGREGATION_WINDOW_SECONDS=60
WAZUH_STREAM_MAX_BUFFER_SIZE=10000
WAZUH_STREAM_MAX_HISTORY_SIZE=1000

# ========================================
# LLM 可观测性 [选填]
# ========================================
# Langfuse LLM 调用追踪
# 获取密钥: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=                  # [选填]
LANGFUSE_SECRET_KEY=                  # [选填]
LANGFUSE_HOST=https://cloud.langfuse.com  # [选填] 自部署时修改

# ========================================
# Worker & 备份 [选填]
# ========================================
#WORKER_ID=worker-1
#BACKUP_DIR=./backups
#BACKUP_RETENTION_DAYS=30
