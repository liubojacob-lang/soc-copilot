{
  "id": "sigma-linux-004",
  "title": "SSH Authorized Keys Modification",
  "description": "Detects modification of SSH authorized_keys files (syscall 257), a common persistence technique.",
  "status": "stable",
  "level": "high",
  "author": "SOC Copilot",
  "category": "linux",
  "tags": [
    "attack.persistence",
    "attack.t1098.004"
  ],
  "mitre_techniques": [
    "T1098.004"
  ],
  "logsource": {
    "product": "linux",
    "service": "audit"
  },
  "detection": {
    "selection": {
      "syscall": 257,
      "path|contains": [
        "authorized_keys",
        ".ssh/"
      ],
      "key": "file_access"
    },
    "condition": "selection"
  },
  "false_positives": [
    "Legitimate SSH key management"
  ],
  "references": [
    "https://attack.mitre.org/techniques/T1098/004/"
  ]
}