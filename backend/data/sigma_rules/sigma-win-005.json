{
  "id": "sigma-win-005",
  "title": "SAM Database Dump via Reg.exe",
  "description": "Detects SAM database and SYSTEM hive dumping via reg.exe save, a common credential theft technique (T1003.002).",
  "status": "stable",
  "level": "high",
  "author": "SOC Copilot",
  "category": "windows",
  "tags": [
    "attack.credential_access",
    "attack.t1003.002"
  ],
  "mitre_techniques": [
    "T1003.002"
  ],
  "logsource": {
    "product": "windows",
    "service": "sysmon"
  },
  "detection": {
    "selection": {
      "EventID": 1,
      "Image|endswith": "reg.exe",
      "CommandLine|contains": [
        "save",
        "sam",
        "system"
      ]
    },
    "condition": "selection"
  },
  "false_positives": [
    "Legitimate registry backup operations"
  ],
  "references": [
    "https://attack.mitre.org/techniques/T1003/002/"
  ]
}