  "level": "medium",
  "author": "SOC Copilot",
  "category": "kubernetes",
  "tags": [
    "attack.credential_access",
    "attack.t1552.007"
  ],
  "mitre_techniques": [
    "T1552.007"
  ],
  "logsource": {
    "product": "kubernetes",
    "service": "audit"
  },
  "detection": {
    "selection": {
      "verb": "list",
      "objectRef.resource": "secrets"
    },
    "condition": "selection"
  },
  "false_positives": [
    "Cluster operators managing secrets"
  ],
  "references": [
    "https://attack.mitre.org/techniques/T1552/007/"
  ]
