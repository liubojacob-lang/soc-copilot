# SOC Copilot Environment Configuration
# Copy this file to .env and update with your values

# ========================================
# Backend Core
# ========================================

# Database Configuration
# Generate secure passwords: openssl rand -base64 32
DB_USER=soc_copilot
DB_PASSWORD=
DB_NAME=soc_copilot

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Backend Security
# Generate secret key: openssl rand -base64 64
SECRET_KEY=
ENVIRONMENT=development

# CORS Configuration
# Comma-separated list of allowed origins
# Example: http://localhost:3000,https://your-domain.com
CORS_ORIGINS=http://localhost:3003

# Logging
LOG_LEVEL=INFO

# ========================================
# AI Provider Configuration
# ========================================
# Options: anthropic, zhipu
AI_PROVIDER=zhipu

# Zhipu AI
ZHIPU_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Optional: Dify AI Integration
DIFY_API_URL=
DIFY_API_KEY=

# ========================================
# Notifications
# ========================================

# Feishu/Lark Webhook
#FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Slack Webhook
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# Email Alerts
#ALERT_EMAIL_TO=security-team@company.com,admin@company.com
#SMTP_SERVER=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USERNAME=your-email@gmail.com
#SMTP_PASSWORD=your-app-password

# Base URL used in alert detail links
#SOC_BASE_URL=https://soc.yourcompany.com

# ========================================
# Threat Intelligence
# ========================================
OTX_API_KEY=
ALLOW_EXTERNAL_TI=false
TI_CACHE_TTL_HOURS=168

# ========================================
# Wazuh Integration
# ========================================
WAZUH_ENABLED=true
WAZUH_REQUIRED=false
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=
WAZUH_VERIFY_SSL=true

WAZUH_INDEXER_PASSWORD=
FILEBEAT_PASSWORD=
WAZUH_EMAIL=wazuh@example.com

WAZUH_DB_USER=wazuh
WAZUH_DB_PASSWORD=
WAZUH_DB_NAME=wazuh

WAZUH_RECEIVER_ENABLED=true
WAZUH_RECEIVER_AUTO_START=true

WAZUH_STREAM_ENABLED=true
WAZUH_STREAM_AGGREGATION_WINDOW_SECONDS=60
WAZUH_STREAM_MAX_BUFFER_SIZE=10000
WAZUH_STREAM_MAX_HISTORY_SIZE=1000

# ========================================
# Worker & Backup
# ========================================
#WORKER_ID=worker-1
#BACKUP_DIR=./backups
#BACKUP_RETENTION_DAYS=30
