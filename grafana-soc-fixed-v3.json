{
  "dashboard": {
    "title": "SOC Copilot 安全运营中心 - 完整版",
    "uid": "soc-copilot-full",
    "schemaVersion": 39,
    "version": 2,
    "description": "完整的安全运营中心仪表板，展示所有安全告警和威胁情报",
    "tags": ["security", "soc", "threat-hunting", "full"],
    "timezone": "browser",
    "refresh": "10s",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "告警总数",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
        "targets": [{
          "datasource": {"type": "loki", "uid": "bfedbqw7nppfkd"},
          "expr": "sum(count_over_time({job=\"soc-copilot\"}[1h]))",
          "refId": "A"
        }],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "displayMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [{"value": null, "color": "green"}, {"value": 50, "color": "yellow"}, {"value": 100, "color": "red"}]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 2,
        "title": "严重告警",
        "type": "stat",
        "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
        "targets": [{
          "datasource": {"type": "loki", "uid": "bfedbqw7nppfkd"},
          "expr": "sum(count_over_time({job=\"soc-copilot\", level=\"critical\"}[1h]))",
          "refId": "A"
        }],
        "options": {"colorMode": "value", "graphMode": "area", "displayMode": "auto"},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [{"value": null, "color": "purple"}, {"value": 1, "color": "red"}]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 3,
        "title": "高危告警",
        "type": "stat",
        "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
        "targets": [{
          "datasource": {"type": "loki", "uid": "bfedbqw7nppfkd"},
          "expr": "sum(count_over_time({job=\"soc-copilot\", level=\"high\"}[1h]))",
          "refId": "A"
        }],
        "options": {"colorMode": "value", "graphMode": "area", "displayMode": "auto"},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [{"value": null, "color": "yellow"}, {"value": 20, "color": "orange"}]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 4,
        "title": "告警趋势 (24小时)",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "datasource": {"type": "loki", "uid": "bfedbqw7nppfkd"},
            "expr": "sum(count_over_time({job=\"soc-copilot\", level=\"critical\"}[5m]))",
            "refId": "A",
            "legendFormat": "严重"
          },
          {
            "datasource": {"type": "loki", "uid": "bfedbqw7nppfkd"},
            "expr": "sum(count_over_time({job=\"soc-copilot\", level=\"high\"}[5m]))",
            "refId": "B",
            "legendFormat": "高危"
          },
          {
            "datasource": {"type": "loki", "uid": "bfedbqw7nppfkd"},
            "expr": "sum(count_over_time({job=\"soc-copilot\", level=\"medium\"}[5m]))",
            "refId": "C",
            "legendFormat": "中危"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "axisLabel": "",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "bars",
              "fillOpacity": 80,
              "gradientMode": "none",
              "hideFrom": {"tooltip": false, "viz": false, "legend": false},
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "scaleDistribution": {"type": "linear"},
              "showPoints": "auto",
              "spanNulls": true
            },
            "color": {"mode": "palette-classic"}
          }
        },
        "options": {
          "legend": {"displayMode": "table", "placement": "bottom"},
          "tooltip": {"mode": "multi"}
        }
      },
      {
        "id": 5,
        "title": "攻击类型分布",
        "type": "piechart",
        "gridPos": {"x": 0, "y": 4, "w": 8, "h": 8},
        "targets": [
          {
            "datasource": {"type": "loki", "uid": "bfedbqw7nppfkd"},
            "expr": "topk(10, sum by (event_type) (count_over_time({job=\"soc-copilot\"}[1h])))",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "right"},
          "pieType": "pie",
          "tooltip": {"mode": "single"}}
      },
      {
        "id": 6,
        "title": "严重级别分布",
        "type": "piechart",
        "gridPos": {"x": 8, "y": 4, "w": 4, "h": 8},
        "targets": [
          {
            "datasource": {"type": "loki", "uid": "bfedbqw7nppfkd"},
            "expr": "topk(10, sum by (level) (count_over_time({job=\"soc-copilot\"}[1h])))",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "bottom"},
          "pieType": "donut",
          "tooltip": {"mode": "single"}
        }
      },
      {
        "id": 7,
        "title": "Top 10 攻击源 IP",
        "type": "table",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "datasource": {"type": "loki", "uid": "bfedbqw7nppfkd"},
            "expr": "topk(10, sum by (source_ip) (count_over_time({job=\"soc-copilot\"}[1h])))",
            "refId": "A",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true},
              "indexByName": {},
              "renameByName": {"Value": "攻击次数", "source_ip": "来源 IP"}
            }
          }
        ],
        "options": {"showHeader": true}
      },
      {
        "id": 8,
        "title": "攻击类型排名",
        "type": "bargauge",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "datasource": {"type": "loki", "uid": "bfedbqw7nppfkd"},
            "expr": "topk(10, sum by (event_type) (count_over_time({job=\"soc-copilot\"}[1h])))",
            "refId": "A",
            "instant": true
          }
        ],
        "options": {
          "displayMode": "gradient",
          "maxVizHeight": 300,
          "minVizHeight": 16,
          "minVizWidth": 8,
          "namePlacement": "auto",
          "orientation": "horizontal",
          "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
          "showUnfilled": true,
          "sizing": "auto",
          "valueMode": "color"
        }
      },
      {
        "id": 9,
        "title": "Agent 告警分布",
        "type": "bargauge",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
        "targets": [
          {
            "datasource": {"type": "loki", "uid": "bfedbqw7nppfkd"},
            "expr": "topk(5, sum by (agent_id) (count_over_time({job=\"soc-copilot\"}[1h])))",
            "refId": "A",
            "instant": true
          }
        ],
        "options": {
          "displayMode": "gradient",
          "orientation": "horizontal",
          "reduceOptions": {"calcs": ["lastNotNull"], "fields": ""},
          "valueMode": "color"
        }
      },
      {
        "id": 10,
        "title": "最新告警流（实时）",
        "type": "logs",
        "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
        "targets": [
          {
            "datasource": {"type": "loki", "uid": "bfedbqw7nppfkd"},
            "expr": "{job=\"soc-copilot\"}",
            "refId": "A"
          }
        ],
        "options": {
          "showLabels": false,
          "showTime": true,
          "wrapLogMessage": false,
          "sortOrder": "Descending",
          "dedupStrategy": "none"
        }
      }
    ]
  },
  "overwrite": true
}
