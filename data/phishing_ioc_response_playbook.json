{
  "name": "Phishing IOC Auto-Response",
  "description": "经典钓鱼邮件IOC自动化处置流程 - OTX情报查询、二次IOC提取、自动处置、报告生成",
  "version": "1.0.0",
  "is_active": true,
  "dag": {
    "nodes": [
      {
        "id": "input_validation",
        "type": "decision",
        "name": "1. 输入校验",
        "position_x": 100,
        "position_y": 50
      },
      {
        "id": "ioc_type_check",
        "type": "decision",
        "name": "2. IOC类型检查",
        "position_x": 300,
        "position_y": 50
      },
      {
        "id": "normalize_ioc",
        "type": "normalize",
        "name": "3. 标准化输入",
        "position_x": 500,
        "position_y": 50
      },
      {
        "id": "ti_lookup_otx",
        "type": "ti_lookup_otx",
        "name": "4. OTX威胁情报查询",
        "position_x": 700,
        "position_y": 50
      },
      {
        "id": "extract_secondary_iocs",
        "type": "extract_iocs",
        "name": "5. 提取二次IOC",
        "position_x": 900,
        "position_y": 50
      },
      {
        "id": "malicious_decision",
        "type": "decision",
        "name": "6. 恶意判定分支",
        "position_x": 700,
        "position_y": 200
      },
      {
        "id": "blocklist_action",
        "type": "http_request",
        "name": "7a. 处置动作-加入黑名单",
        "position_x": 500,
        "position_y": 350
      },
      {
        "id": "slack_notify",
        "type": "slack_notify",
        "name": "8. Slack通知",
        "position_x": 700,
        "position_y": 350
      },
      {
        "id": "generate_report",
        "type": "generate_report",
        "name": "9. 生成处置报告",
        "position_x": 900,
        "position_y": 350
      },
      {
        "id": "case_callback",
        "type": "http_request",
        "name": "10. 回调案例系统",
        "position_x": 1100,
        "position_y": 350
      },
      {
        "id": "low_confidence_report",
        "type": "generate_report",
        "name": "7b. 低置信度报告",
        "position_x": 900,
        "position_y": 200
      },
      {
        "id": "skip_end",
        "type": "http_request",
        "name": "不支持类型结束",
        "position_x": 500,
        "position_y": 150
      }
    ],
    "edges": [
      {
        "source": "input_validation",
        "target": "ioc_type_check"
      },
      {
        "source": "ioc_type_check",
        "target": "normalize_ioc"
      },
      {
        "source": "normalize_ioc",
        "target": "ti_lookup_otx"
      },
      {
        "source": "ti_lookup_otx",
        "target": "extract_secondary_iocs"
      },
      {
        "source": "extract_secondary_iocs",
        "target": "malicious_decision"
      },
      {
        "source": "malicious_decision",
        "target": "blocklist_action"
      },
      {
        "source": "blocklist_action",
        "target": "slack_notify"
      },
      {
        "source": "slack_notify",
        "target": "generate_report"
      },
      {
        "source": "generate_report",
        "target": "case_callback"
      },
      {
        "source": "malicious_decision",
        "target": "low_confidence_report"
      },
      {
        "source": "ioc_type_check",
        "target": "skip_end"
      }
    ]
  }
}
