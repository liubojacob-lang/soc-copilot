# ==============================================================================
# SOC Copilot 本地仿真环境变量模板（docker-compose.local-sim.yml 专用）
#
# 用法：
#   cp .env.local-sim.example .env.local-sim
#   然后把下面每个 CHANGE_ME 换成真实值
#   ./Scripts/sim.sh start
#
# 为什么需要这个文件：
#   docker-compose.local-sim.yml 受版本控制，因此它的敏感值一律写成
#   ${VAR:?} 强制外部注入、不带任何默认值 —— 之前用 ":-默认值" 的写法
#   会把真实密钥提交进 git 历史（2026-09-17 安全审计 F-001/F-002）。
#   本文件是模板，只放占位符；.env.local-sim 已被 .gitignore 覆盖。
# ==============================================================================

# ---------- 仿真数据库 / 缓存（仅监听 127.0.0.1，与宿主机服务隔离）----------
SIM_DB_USER=soc_sim_user
SIM_DB_NAME=soc_sim_db
SIM_DB_PASSWORD=CHANGE_ME_local_sim_db_password

SIM_REDIS_PASSWORD=CHANGE_ME_local_sim_redis_password

# ---------- 应用密钥 ----------
# 生成：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Fernet 主密钥，必须是 32 字节 urlsafe-base64
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=CHANGE_ME_fernet_key

# 首次启动时创建的管理员口令，请勿使用弱口令
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ---------- LLM 供应商 ----------
# 这两项是真实付费凭据，绝不可写入被版本控制的文件
ZHIPU_API_KEY=CHANGE_ME_zhipu_api_key
ZHIPU_MODEL=glm-4-flash

NVIDIA_API_KEY=CHANGE_ME_nvidia_api_key
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

AI_PROVIDER=zhipu
AI_TIMEOUT=90

# ---------- 可选项（不填则用 compose 里的非敏感默认值）----------
# 仿真环境只绑 127.0.0.1，但 CORS 仍不用通配，避免通配 + allow_credentials 组合
# CORS_ORIGINS=http://localhost:13000,http://127.0.0.1:13000
# HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
# ENVIRONMENT=development
# COOKIE_SECURE=false
# STRICT_PRODUCTION_CHECKS=false
