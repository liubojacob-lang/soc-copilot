{
  "name": "soc-copilot-frontend",
  "version": "0.9.4",
  "private": true,
  "scripts": {
    "predev": "node scripts/patch-next.mjs && node scripts/sync-i18n.mjs",
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev --webpack -H 0.0.0.0 -p 3003",
    "dev:turbo": "next dev --turbopack -H 0.0.0.0 -p 3003",
    "clean": "rm -rf .next coverage playwright-report test-results",
    "prebuild": "node scripts/patch-next.mjs && node scripts/sync-i18n.mjs && node scripts/check-i18n-keys.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "tsc --noEmit && node scripts/check-i18n-keys.mjs && node scripts/check-design-tokens.mjs && node scripts/check-contrast.mjs && prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "tokens:check": "node scripts/check-design-tokens.mjs",
    "tokens:baseline": "node scripts/check-design-tokens.mjs --update",
    "contrast:check": "node scripts/check-contrast.mjs",
    "lint:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "i18n:sync": "node scripts/sync-i18n.mjs",
    "i18n:check": "tsx scripts/check-i18n-v2.ts",
    "i18n:check:keys": "node scripts/check-i18n-keys.mjs",
    "i18n:test": "tsx scripts/test-i18n.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "codegen:api": "python3 ../scripts/export_openapi.py && openapi-typescript ../openapi.json -o types/api.generated.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.40.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-window": "^2.3.1",
    "reactflow": "^11.11.4",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "web-vitals": "^5.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.0.2",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.9",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^7",
    "vitest": "^5.0.1"
  }
}
