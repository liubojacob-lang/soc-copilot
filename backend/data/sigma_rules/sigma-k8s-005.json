{
  "id": "sigma-k8s-005",
  "title": "Kubernetes ClusterRoleBinding to Cluster-Admin",
  "description": "Detects creation of ClusterRoleBinding granting cluster-admin role to users or service accounts.",
  "status": "stable",
  "level": "critical",
  "author": "SOC Copilot",
  "category": "kubernetes",
  "tags": [
    "attack.persistence",
    "attack.t1098"
  ],
  "mitre_techniques": [
    "T1098"
  ],
  "logsource": {
    "product": "kubernetes",
    "service": "audit"
  },
  "detection": {
    "selection": {
      "verb": "create",
      "objectRef.resource": "clusterrolebindings",
      "requestObject.roleRef.name": "cluster-admin"
    },
    "condition": "selection"
  },
  "false_positives": [
    "Cluster administrators creating legitimate bindings"
  ],
  "references": [
    "https://attack.mitre.org/techniques/T1098/"
  ]
}