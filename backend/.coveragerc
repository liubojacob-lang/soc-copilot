[run]
source = .
omit =
    tests/*
    */tests/*
    check_db.py
    migrate.py
    start_server.py
    import_phishing_playbook.py
    init_ai_models.py
    init_correlation_rules.py
    verify_jwt_invalidation.py
    # Ad-hoc root-level scripts (never collected by pytest, testpaths=tests)
    test_ai_models_api.py
    test_api_simple.py
    test_enrichment.py
    test_import.py
    test_loki_integration.py
    test_optimizations.py
    test_security_alerts.py
    # Example/doc code, imported by nothing
    services/message_broker/example_usage.py
    conftest.py
    __pycache__/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if TYPE_CHECKING:
    @abstractmethod
# Coverage threshold is set in a single place: pytest.ini's --cov-fail-under
# (the CLI flag overrides any value here, so defining it in both files is a
# maintenance trap). Do not re-add fail_under here.
